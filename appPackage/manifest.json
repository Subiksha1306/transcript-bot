{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
    "manifestVersion": "1.16",
    "version": "1.0.0",
    "id": "2f51c955-a012-4c29-80a3-98d929fa1e25",
    "packageName": "com.transcriptbot.teamsapp",
    "developer": {
        "name": "Subiksha / Standup Bot",
        "websiteUrl": "https://github.com/Subiksha1306/transcript-bot",
        "privacyUrl": "https://github.com/Subiksha1306/transcript-bot",
        "termsOfUseUrl": "https://github.com/Subiksha1306/transcript-bot"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Transcript Bot",
        "full": "AI Standup Transcript Task Extractor"
    },
    "description": {
        "short": "Extracts assigned tasks from meeting transcripts",
